
const express = require("express");
const cors = require("cors");

const app = express();
app.use(cors());
app.use(express.json({ limit: "1mb" }));

const PORT = process.env.PORT || 3000;
const VERIFY_TOKEN = process.env.META_VERIFY_TOKEN || "";
const OPENAI_API_KEY = process.env.OPENAI_API_KEY || "";
const WHATSAPP_TOKEN = process.env.WHATSAPP_ACCESS_TOKEN || "";
const WHATSAPP_PHONE_ID = process.env.WHATSAPP_PHONE_NUMBER_ID || "";
const PAGE_TOKEN = process.env.MESSENGER_PAGE_ACCESS_TOKEN || "";
const GRAPH_VERSION = process.env.GRAPH_API_VERSION || "v23.0";

// Backend status
app.get("/", (req, res) => {
  res.send("AI Business Chat Backend is running!");
});

app.get("/api/status", (req, res) => {
  res.json({
    status: "online",
    message: "Backend API is running",
    webhook: "/webhook"
  });
});

// Meta Webhook verification
app.get("/webhook", (req, res) => {
  const mode = req.query["hub.mode"];
  const token = req.query["hub.verify_token"];
  const challenge = req.query["hub.challenge"];

  if (
    mode === "subscribe" &&
    VERIFY_TOKEN &&
    token === VERIFY_TOKEN &&
    challenge
  ) {
    return res.status(200).send(challenge);
  }

  return res.sendStatus(403);
});

// AI response
async function getAIReply(userMessage, platform) {
  if (!OPENAI_API_KEY) {
    return "ধন্যবাদ! আপনার মেসেজটি পেয়েছি। আমাদের টিম শিগগিরই আপনাকে সাহায্য করবে।";
  }

  const response = await fetch("https://api.openai.com/v1/responses", {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${OPENAI_API_KEY}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: process.env.OPENAI_MODEL || "gpt-4.1-mini",
      instructions:
        "তুমি একটি বাংলাদেশি ব্যবসার সহকারী। বাংলায় ভদ্র ও সংক্ষিপ্ত উত্তর দেবে। " +
        "পণ্যের দাম, স্টক বা ডেলিভারি সম্পর্কে নিশ্চিত তথ্য না থাকলে বানিয়ে বলবে না। " +
        "প্রয়োজনে কাস্টমারের নাম, ফোন ও অর্ডারের বিবরণ জানতে চাইবে। " +
        "নিজেকে মানুষ বলে পরিচয় দেবে না। প্ল্যাটফর্ম: " + platform,
      input: userMessage,
      max_output_tokens: 250
    })
  });

  if (!response.ok) {
    throw new Error("OpenAI API error: " + response.status);
  }

  const data = await response.json();
  const answer = data.output_text;

  return answer ||
    "আপনার মেসেজের জন্য ধন্যবাদ। অনুগ্রহ করে একটু পরে আবার চেষ্টা করুন।";
}

// Send WhatsApp message
async function sendWhatsApp(to, message) {
  if (!WHATSAPP_TOKEN || !WHATSAPP_PHONE_ID) {
    throw new Error("WhatsApp credentials are not configured");
  }

  const response = await fetch(
    `https://graph.facebook.com/${GRAPH_VERSION}/${WHATSAPP_PHONE_ID}/messages`,
    {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${WHATSAPP_TOKEN}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        messaging_product: "whatsapp",
        recipient_type: "individual",
        to,
        type: "text",
        text: { body: message }
      })
    }
  );

  if (!response.ok) {
    const error = await response.text();
    throw new Error("WhatsApp send error: " + error);
  }
}

// Send Messenger message
async function sendMessenger(recipientId, message) {
  if (!PAGE_TOKEN) {
    throw new Error("Messenger Page token is not configured");
  }

  const response = await fetch(
    `https://graph.facebook.com/${GRAPH_VERSION}/me/messages`,
    {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${PAGE_TOKEN}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        recipient: { id: recipientId },
        messaging_type: "RESPONSE",
        message: { text: message }
      })
    }
  );

  if (!response.ok) {
    const error = await response.text();
    throw new Error("Messenger send error: " + error);
  }
}

// Receive WhatsApp and Messenger webhook events
app.post("/webhook", (req, res) => {
  // Respond quickly so Meta does not repeatedly retry the webhook.
  res.sendStatus(200);

  processWebhook(req.body).catch((error) => {
    console.error("Webhook processing failed:", error.message);
  });
});

async function processWebhook(body) {
  // WhatsApp messages
  if (body.object === "whatsapp_business_account") {
    for (const entry of body.entry || []) {
      for (const change of entry.changes || []) {
        const value = change.value || {};

        for (const msg of value.messages || []) {
          if (msg.type !== "text" || !msg.text?.body) continue;

          try {
            const reply = await getAIReply(msg.text.body, "WhatsApp");
            await sendWhatsApp(msg.from, reply);
          } catch (error) {
            console.error("WhatsApp reply failed:", error.message);
          }
        }
      }
    }
    return;
  }

  // Facebook Messenger messages
  if (body.object === "page") {
    for (const entry of body.entry || []) {
      for (const event of entry.messaging || []) {
        if (!event.message || event.message.is_echo) continue;
        if (!event.sender?.id || !event.message.text) continue;

        try {
          const reply = await getAIReply(
            event.message.text,
            "Facebook Messenger"
          );
          await sendMessenger(event.sender.id, reply);
        } catch (error) {
          console.error("Messenger reply failed:", error.message);
        }
      }
    }
  }
}

app.listen(PORT, "0.0.0.0", () => {
  console.log(`AI Business Chat API listening on port ${PORT}`);
});
